NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
CRON_SECRET=
CONTACT_RATE_LIMIT_SECRET=

# HTTPメール配信（Cloudflare Workers 本番では Resend を使用）
# ローカルで外部送信を行わない場合は disabled を設定する。
MAIL_DELIVERY_MODE=disabled
# Cloudflare本番では d1、ローカルでResendを直接試す場合は direct。
EMAIL_DELIVERY_BACKEND=direct
RESEND_API_KEY=
EMAIL_FROM=こまクック <noreply@komacook.jp>
CONTACT_TO_EMAIL=daiki.hayakawa.work@gmail.com
REPORT_TO_EMAIL=daiki.hayakawa.work@gmail.com

# ローカル回帰テスト（省略時はdocs/test-data.mdの一般会員を使用）
TEST_USER_EMAIL=user@komacook.local
TEST_USER_PASSWORD=Komacook!User2026
