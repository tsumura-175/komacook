{
  "name": "komacook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.ts --update-snapshots",
    "test:db": "supabase test db --local",
    "test:all": "npm run test:db && npm run test:coverage",
    "test:coverage": "vitest run --coverage",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "maintenance:run": "node --env-file=.env.local scripts/run-account-deletions.mjs",
    "accounts:purge": "node --env-file=.env.local scripts/run-account-deletions.mjs",
    "maintenance:deploy": "wrangler deploy --config cloudflare/maintenance/wrangler.jsonc",
    "backup:local": "node --env-file=.env.local scripts/backup-local.mjs",
    "restore:local": "node --env-file=.env.local scripts/restore-local.mjs",
    "dev:vinext": "vinext dev --port 3011",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy": "npm run deploy:vinext",
    "cf:typegen": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply komacook-production --local",
    "d1:migrate:remote": "wrangler d1 migrations apply komacook-production --remote",
    "d1:seed:local": "wrangler d1 execute komacook-production --local --file cloudflare/d1/seed.sql",
    "d1:seed:remote": "wrangler d1 execute komacook-production --remote --file cloudflare/d1/seed.sql",
    "r2:maintenance:tail": "wrangler tail --config cloudflare/maintenance/wrangler.jsonc"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^3.1.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.3.0",
    "sharp": "^0.35.4",
    "vinext": "^1.0.0-beta.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "postgres": "^3.4.9",
    "supabase": "^2.114.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  },
  "type": "module"
}
