{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "komacook",
  "keep_vars": true,
  "vars": {
    "APP_DATA_BACKEND": "d1"
  },
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Cloudflare の Git 連携デプロイでは build 完了後にこの設定を読む。
  // 汎用の vinext fetch handler ではなく、ビルドごとに生成される Worker を
  // 配置しないと、Server Action が参照する遅延読み込みチャンクとずれる。
  "main": "dist/server/index.js",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "komacook-production",
      "database_id": "9bdf8b58-5326-48ab-9054-472ae2ae35f1",
      "migrations_dir": "cloudflare/d1/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "komacook-images-production"
    }
  ]
}
